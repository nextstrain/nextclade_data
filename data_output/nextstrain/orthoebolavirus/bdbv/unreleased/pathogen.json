{
  "$schema": "https://raw.githubusercontent.com/nextstrain/nextclade/refs/heads/release/packages/nextclade-schemas/input-pathogen-json.schema.json",
  "alignmentParams": {
    "excessBandwidth": 100,
    "terminalBandwidth": 300,
    "allowedMismatches": 10,
    "windowSize": 40,
    "minSeedCover": 0.03,
    "gapAlignmentSide": "left",
    "retryReverseComplement": true
  },
  "attributes": {
    "name": "Bundibugyo ebolavirus",
    "reference accession": "NC_014373.1",
    "reference name": "UGA/2007/Butalya-811250"
  },
  "compatibility": {
    "cli": "3.0.0-alpha.0",
    "web": "3.0.0-alpha.0"
  },
  "files": {
    "treeJson": "tree.json",
    "changelog": "CHANGELOG.md",
    "examples": "examples.fasta",
    "genomeAnnotation": "genome_annotation.gff3",
    "pathogenJson": "pathogen.json",
    "readme": "README.md",
    "reference": "reference.fasta"
  },
  "mutationPatterns": {
    "patterns": [
      {
        "id": "adar",
        "name": "ADAR-like RNA editing",
        "description": "ADAR-mediated A-to-I editing, observed as A>G, and as T>C on the opposite strand",
        "events": [
          {
            "type": "nucSubstitution",
            "ref": [
              "A"
            ],
            "qry": [
              "G"
            ],
            "bothStrands": true
          }
        ],
        "cluster": {
          "windowSize": 50,
          "cutoff": 3
        }
      },
      {
        "id": "apobec",
        "name": "APOBEC3-like cytosine deamination",
        "description": "APOBEC3-like cytosine deamination, observed as C>T in TCW context, and as G>A in WGA context on the opposite strand",
        "events": [
          {
            "type": "nucSubstitution",
            "ref": [
              "C"
            ],
            "qry": [
              "T"
            ],
            "motifs": [
              "T(C)W"
            ],
            "bothStrands": true
          }
        ],
        "cluster": {
          "windowSize": 50,
          "cutoff": 3
        }
      }
    ]
  },
  "qc": {
    "frameShifts": {
      "enabled": true,
      "ignoredFrameShifts": [],
      "scoreWeight": 50
    },
    "missingData": {
      "enabled": true,
      "missingDataThreshold": 3000,
      "scoreBias": 500
    },
    "mixedSites": {
      "enabled": true,
      "mixedSitesThreshold": 20
    },
    "privateMutations": {
      "cutoff": 10,
      "enabled": true,
      "typical": 3,
      "weightLabeledSubstitutions": 3,
      "weightReversionSubstitutions": 3,
      "weightUnlabeledSubstitutions": 1
    },
    "snpClusters": {
      "clusterCutOff": 3,
      "enabled": true,
      "scoreWeight": 50,
      "windowSize": 50
    },
    "stopCodons": {
      "enabled": true,
      "ignoredStopCodons": [
        {
          "cdsName": "GP_003",
          "codon": 366
        }
      ],
      "scoreWeight": 20
    }
  },
  "schemaVersion": "3.0.0",
  "shortcuts": [
    "nextstrain/ebola/bdbv"
  ],
  "version": {
    "tag": "unreleased",
    "compatibility": {
      "cli": "3.0.0-alpha.0",
      "web": "3.0.0-alpha.0"
    }
  }
}
