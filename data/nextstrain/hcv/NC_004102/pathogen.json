{
  "$schema": "https://raw.githubusercontent.com/nextstrain/nextclade/refs/heads/release/packages/nextclade-schemas/input-pathogen-json.schema.json",
  "schemaVersion": "3.0.0",
  "files": {
    "reference": "reference.fasta",
    "pathogenJson": "pathogen.json",
    "genomeAnnotation": "annotation.gff",
    "treeJson": "tree.json",
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "examples": "sequences.fasta"
  },
  "minimizerIndex": {
    "references": [
      "additional_references.fasta"
    ]
  },
  "attributes": {
    "name": "Hepatitis C virus (all genotypes)",
    "reference name": "HCV isolate H77",
    "reference accession": "NC_004102.1"
  },
  "alignmentParams": {
    "penaltyGapOpen": 15,
    "penaltyGapOpenInFrame": 51,
    "penaltyGapOpenOutOfFrame": 71,
    "gapAlignmentSide": "left",
    "excessBandwidth": 100,
    "terminalBandwidth": 200,
    "kmerLength": 10,
    "kmerDistance": 20,
    "minMatchLength": 40,
    "allowedMismatches": 12,
    "windowSize": 30,
    "minSeedCover": 0.05,
    "retryReverseComplement": true
  },
  "placementMaskRanges": [
    {
      "begin": 0,
      "end": 50
    },
    {
      "begin": 1490,
      "end": 1570
