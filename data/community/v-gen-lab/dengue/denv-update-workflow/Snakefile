configfile: "config/config.yaml"

from pathlib import Path
import shlex
import sys

sys.path.insert(0, str(Path('scripts').resolve()))
from update_dataset import checked_run_snapshot

if not config.get('metadata_run_manifest'):
    raise WorkflowError(
        'Start updates with: python scripts/update_dataset.py --cores N. '
        'For offline replay, add --snapshot PATH to that command.'
    )
config['data_use_snapshot'] = checked_run_snapshot(
    config['metadata_run_manifest'], config['input_package']
)

BUILDS = config["builds"]
PACKAGE = config["input_package"]
BASELINE_VERSION = config["baseline_version"]
DATASET_HISTORY_ROOT = config["dataset_history_root"]
RELEASE_NOTES = config["release_notes"]
DATASETS_ROOT = "results/datasets"
DATASET_FILES = [
    "data-use.tsv",
    "README.md",
    "CHANGELOG.md",
    "reference.fasta",
    "pathogen.json",
    "genome_annotation.gff3",
    "sequences.fasta",
    "tree.json",
]

wildcard_constraints:
    build="denv[1-4]"


def latest_dataset(build):
    candidates = sorted(path for path in Path(DATASET_HISTORY_ROOT, build).iterdir() if path.is_dir())
    if not candidates:
        raise ValueError(f"No released dataset found for {build} in {DATASET_HISTORY_ROOT}")
    return str(candidates[-1])

rule all:
    input:
        expand("results/{build}/validation.tsv", build=BUILDS),
        expand("results/{build}/tree.json", build=BUILDS),
        expand("results/{build}/clades.diff.tsv", build=BUILDS),
        expand("results/{build}/clades.version.json", build=BUILDS),
        expand(f"{DATASETS_ROOT}/{{build}}/{{filename}}", build=BUILDS, filename=DATASET_FILES),

rule align:
    input:
        sequences=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_representatives.fasta",
        reference=lambda wc: f"{latest_dataset(wc.build)}/reference.fasta",
        pathogen=lambda wc: f"{latest_dataset(wc.build)}/pathogen.json",
        annotation=lambda wc: f"{latest_dataset(wc.build)}/genome_annotation.gff3",
    output:
        "results/{build}/aligned.fasta"
    threads: config["resources"]["align_threads"]
    shell:
        """
        nextclade3 run --jobs {threads} --input-ref {input.reference} \\
          --input-pathogen-json {input.pathogen} --input-annotation {input.annotation} \\
          --output-fasta {output} --silent {input.sequences}
        """

rule crop_coding_region:
    input:
        alignment="results/{build}/aligned.fasta",
        annotation=lambda wc: f"{latest_dataset(wc.build)}/genome_annotation.gff3",
    output:
        "results/{build}/coding-aligned.fasta"
    shell:
        "python scripts/crop_coding_region.py --alignment {input.alignment} --gff {input.annotation} --output {output}"

rule supplied_tree_to_newick:
    # Preserve the topology curated in the representative-tree NEXUS input.
    input:
        tree=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_representatives.tree",
        representatives=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_representatives.fasta",
    output: "results/{build}/tree.supplied.nwk"
    shell:
        "python scripts/nexus_to_newick.py --input {input.tree} --expected-fasta {input.representatives} --output {output}"

rule refine:
    input:
        tree="results/{build}/tree.supplied.nwk",
        alignment="results/{build}/coding-aligned.fasta",
    output:
        tree="results/{build}/tree.nwk",
        branches="results/{build}/branch_lengths.json",
    shell:
        "augur refine --tree {input.tree} --alignment {input.alignment} --root mid_point --output-tree {output.tree} --output-node-data {output.branches}"

rule ancestral:
    input:
        tree="results/{build}/tree.nwk",
        # The tree is inferred from the coding region, but mutation positions
        # must remain in reference-genome coordinates for Nextclade.
        alignment="results/{build}/aligned.fasta",
        reference=lambda wc: f"{latest_dataset(wc.build)}/reference.fasta",
    output: "results/{build}/muts.json"
    shell:
        "augur ancestral --tree {input.tree} --alignment {input.alignment} --root-sequence {input.reference} --inference joint --output-node-data {output}"

rule translate:
    input:
        tree="results/{build}/tree.nwk",
        ancestral="results/{build}/muts.json",
        annotation=lambda wc: f"{latest_dataset(wc.build)}/genome_annotation.gff3",
    output: "results/{build}/aa_muts.json"
    shell:
        "augur translate --tree {input.tree} --ancestral-sequences {input.ancestral} --reference-sequence {input.annotation} --output-node-data {output}"

rule discover_markers:
    input:
        tree="results/{build}/tree.nwk",
        muts="results/{build}/muts.json",
        labels=lambda wc: f"{PACKAGE}/sequence_lineages.csv",
        nexus=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_representatives.tree",
    output:
        clades="results/{build}/clades.proposed.tsv",
        report="results/{build}/marker_report.tsv",
    params:
        serotype=lambda wc: "DENV" + wc.build[-1],
        min_support=config["markers"]["min_support"],
        min_markers=config["markers"]["min_markers"],
        max_markers=config["markers"]["max_markers"],
        max_outgroup=config["markers"]["max_outgroup_support"],
    shell:
        "python scripts/discover_lineage_markers.py --tree {input.tree} --mutations {input.muts} --labels {input.labels} --nexus {input.nexus} --serotype {params.serotype} --clades-output {output.clades} --report-output {output.report} --min-support {params.min_support} --min-markers {params.min_markers} --max-markers {params.max_markers} --max-outgroup-support {params.max_outgroup}"

rule compare_definitions:
    input:
        baseline=lambda wc: f"definitions/{BASELINE_VERSION}/{wc.build}/clades.tsv",
        proposal="results/{build}/clades.proposed.tsv",
    output:
        diff="results/{build}/clades.diff.tsv",
        manifest="results/{build}/clades.version.json",
    params:
        version=BASELINE_VERSION,
    shell:
        "python scripts/compare_definitions.py --baseline {input.baseline} --proposal {input.proposal} --baseline-version {params.version} --diff-output {output.diff} --manifest-output {output.manifest}"

rule add_clade_inheritance:
    input:
        definitions="results/{build}/clades.proposed.tsv",
        nexus=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_representatives.tree",
    output:
        definitions="results/{build}/clades.inherited.tsv",
        report="results/{build}/inheritance.tsv",
    shell:
        "python scripts/add_clade_inheritance.py --definitions {input.definitions} --nexus {input.nexus} --output {output.definitions} --report {output.report}"

rule clades:
    input:
        tree="results/{build}/tree.nwk",
        muts="results/{build}/muts.json",
        clades="results/{build}/clades.inherited.tsv",
    output: "results/{build}/clades.json"
    shell: "augur clades --tree {input.tree} --mutations {input.muts} --clades {input.clades} --output-node-data {output}"


rule generate_metadata:
    input:
        script="scripts/generate_metadata.py",
        data_use_helper="scripts/data_use.py",
        ncbi_helper="scripts/ncbi_metadata.py",
        data_use_snapshot=config["data_use_snapshot"],
        labels=lambda wc: f"{PACKAGE}/sequence_lineages.csv",
    output:
        metadata=temp("results/{build}/metadata.tsv"),
        ordering="results/{build}/color_ordering.tsv",
    params:
        serotype=lambda wc: "DENV" + wc.build[-1],
    shell:
        "python {input.script:q} --labels {input.labels:q} --serotype {params.serotype} --data-use-snapshot {input.data_use_snapshot:q} --metadata-output {output.metadata:q} --ordering-output {output.ordering:q}"


rule assign_colors:
    input:
        ordering="results/{build}/color_ordering.tsv",
        metadata="results/{build}/metadata.tsv",
        schemes="config/color_schemes.tsv",
    output:
        "results/{build}/colors.tsv",
    shell:
        "python scripts/assign-colors.py --ordering {input.ordering} --color-schemes {input.schemes} --metadata {input.metadata} --output {output}"

rule export_tree:
    input:
        tree="results/{build}/tree.nwk",
        branches="results/{build}/branch_lengths.json",
        muts="results/{build}/muts.json",
        aa_muts="results/{build}/aa_muts.json",
        clades="results/{build}/clades.json",
        metadata="results/{build}/metadata.tsv",
        colors="results/{build}/colors.tsv",
        # Keep the Auspice metadata (including the dataset title) in every
        # exported tree, selecting the config for the current DENV serotype.
        auspice_config=lambda wc: f"config/auspice_config_d{wc.build[-1]}.json",
        annotation=lambda wc: f"{latest_dataset(wc.build)}/genome_annotation.gff3",
        reference=lambda wc: f"{latest_dataset(wc.build)}/reference.fasta",
        mask_script="scripts/derive_placement_mask_ranges.py",
        coding_bounds_script="scripts/crop_coding_region.py",
    output: "results/{build}/tree.json"
    shell:
        "augur export v2 --tree {input.tree} --metadata {input.metadata} --node-data {input.branches} {input.muts} {input.aa_muts} {input.clades} --colors {input.colors} --auspice-config {input.auspice_config} --include-root-sequence-inline --output {output} && python {input.mask_script:q} --gff {input.annotation:q} --reference {input.reference:q} --target-tree {output:q}"

rule validate:
    input:
        dataset="results/{build}/tree.json",
        reference=lambda wc: f"{latest_dataset(wc.build)}/reference.fasta",
        pathogen=lambda wc: f"{latest_dataset(wc.build)}/pathogen.json",
        annotation=lambda wc: f"{latest_dataset(wc.build)}/genome_annotation.gff3",
        test_fasta="results/datasets/{build}/sequences.fasta",
        expected=lambda wc: f"{PACKAGE}/test_set.csv",
    output: "results/{build}/validation.tsv"
    params:
        serotype=lambda wc: "DENV" + wc.build[-1],
    shell:
        "nextclade3 run --input-ref {input.reference} --input-tree {input.dataset} --input-pathogen-json {input.pathogen} --input-annotation {input.annotation} --output-tsv results/{wildcards.build}/test.nextclade.tsv --silent {input.test_fasta} && python scripts/validate_assignments.py --assignments results/{wildcards.build}/test.nextclade.tsv --expected {input.expected} --serotype {params.serotype} --output {output}"


rule assemble_dataset:
    input:
        assembler="scripts/assemble_dataset.py",
        data_use_helper="scripts/data_use.py",
        ncbi_helper="scripts/ncbi_metadata.py",
        data_use_snapshot=config["data_use_snapshot"],
        data_use_notice=lambda wc: config["data_use_notices"][wc.build],
        baseline_definitions=lambda wc: f"definitions/{BASELINE_VERSION}/{wc.build}/clades.tsv",
        current_definitions="results/{build}/clades.inherited.tsv",
        tree="results/{build}/tree.json",
        test_fasta=lambda wc: f"{PACKAGE}/DENV{wc.build[-1]}_test_set.fasta",
        current=lambda wc: expand(
            f"{latest_dataset(wc.build)}/{{filename}}",
            filename=["README.md", "reference.fasta", "pathogen.json", "genome_annotation.gff3"],
        ),
        changelog=lambda wc: f"{latest_dataset(wc.build)}/CHANGELOG.md",
    output:
        expand(DATASETS_ROOT + "/{{build}}/{filename}", filename=DATASET_FILES),
    params:
        release_notes=" ".join(
            f"--release-note {shlex.quote(note)}" for note in RELEASE_NOTES
        ),
    shell:
        "python {input.assembler:q} --build {wildcards.build} --dataset-history-root {DATASET_HISTORY_ROOT:q} --test-set {input.test_fasta:q} --tree {input.tree:q} --output-dir results/datasets/{wildcards.build} --data-use-notice {input.data_use_notice:q} --data-use-snapshot {input.data_use_snapshot:q} --baseline-definitions {input.baseline_definitions:q} --current-definitions {input.current_definitions:q} {params.release_notes}"
